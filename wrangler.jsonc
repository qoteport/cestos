{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cestos",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cestos"
    }
  ],
  "vars": {
    "CESTOS_API_BACKEND_URL": "https://cestos-oversight-629203414453.europe-west1.run.app",
    "CESTOS_API_URL": "https://cestos-oversight-629203414453.europe-west1.run.app"
  }
}
