{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cestos",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cestos"
    }
  ],
{
  "vars": {
    "CESTOS_API_BACKEND_URL": "https://cestos-oversight.fly.dev",
    "CESTOS_API_URL": "https://cestos-oversight.fly.dev"
  },
}
}
